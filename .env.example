# ---- Required (set these in Vercel > Project > Settings > Environment Variables) ----

# Supabase. The server accepts any of these names, including the ones the
# Vercel Supabase integration creates (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ...).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""        # server-only secret. Never prefix with VITE_ or NEXT_PUBLIC_

# Secret used to sign login sessions. Use a long random value:  openssl rand -base64 48
# (If omitted, the server falls back to SUPABASE_JWT_SECRET, then SUPABASE_SERVICE_ROLE_KEY.)
SESSION_SECRET=""

# One-time key that lets you create the FIRST platform super admin. Required in production.
SUPER_ADMIN_SETUP_KEY=""

# ---- Optional ----
GEMINI_API_KEY=""
GMAIL_USER="intellicaautomationgroup@gmail.com"
GMAIL_APP_PASSWORD=""               # Google App Password, needed for real emails (reset codes, credentials)
PORT=3000
